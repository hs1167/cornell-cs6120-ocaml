opam-version: "2.0"
synopsis: "Atelier OCaml pour les leçons 1 à 6 de Cornell CS6120"
maintainer: "Atelier CS6120"
authors: "Atelier CS6120"
depends: [
  "ocaml" {= "5.3.0"}
  "dune" {= "3.24.2"}
  "yojson" {= "3.0.0"}
]
build: [
  ["dune" "build" "-p" name "-j" jobs]
  ["dune" "runtest" "-p" name "-j" jobs] {with-test}
]
